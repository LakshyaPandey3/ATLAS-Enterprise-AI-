# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
S3_BUCKET=your_s3_bucket_name

# Amazon Bedrock Configuration
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=atlas-enterprise-ai-index
PINECONE_CLOUD=aws
PINECONE_REGION=ap-southeast-2
PINECONE_READY_TIMEOUT=180

# PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/atlas

# Application Configuration
MAX_UPLOAD_BYTES=10485760
MIN_RELEVANCE=0.25
HITL_ENABLED=true
MEMORY_TURNS=6

# RIUS Observability Configuration
RIUS_API_KEY=your_rius_api_key
RIUS_SERVICE_NAME=atlas-ai-enterprise
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false